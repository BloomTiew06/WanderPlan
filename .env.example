# All of these are optional. With none set, the app runs entirely on local
# fallbacks — deterministic planner, sample flight/stay pricing, an offline
# translation glossary, and an in-app outbox instead of SMS and email.
#
# Each variable points at YOUR OWN server-side proxy, not the vendor directly.
# Never put a provider API key in a Vite env var: anything prefixed VITE_ is
# inlined into the JavaScript bundle and is readable by anyone who loads the page.

# POST { system, input } -> returns the structured JSON described in services/ai.ts.
# Back this with the Claude or OpenAI API on the server side.
VITE_AI_ENDPOINT=

# Flight and stay search (Amadeus self-service or equivalent), proxied server-side.
VITE_AMADEUS_ENDPOINT=

# POST { text, target } -> { text }. Back this with Google Translate or DeepL.
VITE_TRANSLATE_ENDPOINT=
